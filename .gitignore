# 依赖与构建
node_modules/
__pycache__/
*.log
.DS_Store
.env
.claude/
.zcode/

# 打包产物与二进制资产
packaging/
*.exe
*.svg
*.ico
*.png
*.jpg
*.jpeg
*.gif
*.pdf
*.zip
*.rar
*.7z

# 图标资产（前端 favicon/logo 与主图源文件）
!web-app/frontend/dist/favicon.ico
!web-app/frontend/dist/favicon-*.png
!web-app/frontend/dist/logo.png
!icon/icon_1024.png

# Office 文档与临时文件（templates/ 下的模板文件除外，作为解析格式的基准样例）
*.xls
*.xlsx
*.doc
*.docx
*.ppt
*.pptx
~$*
!templates/*.xlsx
!templates/*.docx

# 本地助手工作记忆（不入库）
.workbuddy/
